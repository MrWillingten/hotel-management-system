digraph erd {
  graph [rankdir=TB, nodesep=0.35, ranksep=0.6, fontname="Liberation Sans", pad=0.2, splines=true];
  node [shape=plain, fontname="Liberation Sans", fontsize=10];
  edge [dir=both, fontname="Liberation Sans", fontsize=9, color="#3b2f2a", fontcolor="#6b4a3a", arrowsize=0.9];
  ROOM_CATEGORY [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#3b2f2a"><TR><TD COLSPAN="2" BGCOLOR="#3b2f2a"><FONT COLOR="white"><B>ROOM_CATEGORY</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="RIGHT"><FONT COLOR="#a0522d">PK</FONT></TD></TR><TR><TD ALIGN="LEFT">name</TD><TD ALIGN="RIGHT"><FONT COLOR="#a0522d">UQ</FONT></TD></TR><TR><TD ALIGN="LEFT">description</TD><TD ALIGN="RIGHT"><FONT COLOR="#a0522d"> </FONT></TD></TR></TABLE>>];
  ROOM [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#3b2f2a"><TR><TD COLSPAN="2" BGCOLOR="#3b2f2a"><FONT COLOR="white"><B>ROOM</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="RIGHT"><FONT COLOR="#a0522d">PK</FONT></TD></TR><TR><TD ALIGN="LEFT">number</TD><TD ALIGN="RIGHT"><FONT COLOR="#a0522d">UQ</FONT></TD></TR><TR><TD ALIGN="LEFT">category_id</TD><TD ALIGN="RIGHT"><FONT COLOR="#a0522d">FK</FONT></TD></TR><TR><TD ALIGN="LEFT">capacity</TD><TD ALIGN="RIGHT"><FONT COLOR="#a0522d"> </FONT></TD></TR><TR><TD ALIGN="LEFT">nightly_rate</TD><TD ALIGN="RIGHT"><FONT COLOR="#a0522d"> </FONT></TD></TR><TR><TD ALIGN="LEFT">in_service</TD><TD ALIGN="RIGHT"><FONT COLOR="#a0522d"> </FONT></TD></TR><TR><TD ALIGN="LEFT">housekeeping</TD><TD ALIGN="RIGHT"><FONT COLOR="#a0522d"> </FONT></TD></TR></TABLE>>];
  RATE_PERIOD [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#3b2f2a"><TR><TD COLSPAN="2" BGCOLOR="#3b2f2a"><FONT COLOR="white"><B>RATE_PERIOD</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="RIGHT"><FONT COLOR="#a0522d">PK</FONT></TD></TR><TR><TD ALIGN="LEFT">category_id</TD><TD ALIGN="RIGHT"><FONT COLOR="#a0522d">FK</FONT></TD></TR><TR><TD ALIGN="LEFT">name</TD><TD ALIGN="RIGHT"><FONT COLOR="#a0522d"> </FONT></TD></TR><TR><TD ALIGN="LEFT">start_date</TD><TD ALIGN="RIGHT"><FONT COLOR="#a0522d"> </FONT></TD></TR><TR><TD ALIGN="LEFT">end_date</TD><TD ALIGN="RIGHT"><FONT COLOR="#a0522d"> </FONT></TD></TR><TR><TD ALIGN="LEFT">rate</TD><TD ALIGN="RIGHT"><FONT COLOR="#a0522d"> </FONT></TD></TR></TABLE>>];
  MAINTENANCE [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#3b2f2a"><TR><TD COLSPAN="2" BGCOLOR="#3b2f2a"><FONT COLOR="white"><B>MAINTENANCE</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="RIGHT"><FONT COLOR="#a0522d">PK</FONT></TD></TR><TR><TD ALIGN="LEFT">room_id</TD><TD ALIGN="RIGHT"><FONT COLOR="#a0522d">FK</FONT></TD></TR><TR><TD ALIGN="LEFT">start_date</TD><TD ALIGN="RIGHT"><FONT COLOR="#a0522d"> </FONT></TD></TR><TR><TD ALIGN="LEFT">end_date</TD><TD ALIGN="RIGHT"><FONT COLOR="#a0522d"> </FONT></TD></TR><TR><TD ALIGN="LEFT">reason</TD><TD ALIGN="RIGHT"><FONT COLOR="#a0522d"> </FONT></TD></TR></TABLE>>];
  ROOM_NIGHT [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#3b2f2a"><TR><TD COLSPAN="2" BGCOLOR="#3b2f2a"><FONT COLOR="white"><B>ROOM_NIGHT</B></FONT></TD></TR><TR><TD ALIGN="LEFT">room_id</TD><TD ALIGN="RIGHT"><FONT COLOR="#a0522d">PK, FK</FONT></TD></TR><TR><TD ALIGN="LEFT">night</TD><TD ALIGN="RIGHT"><FONT COLOR="#a0522d">PK</FONT></TD></TR><TR><TD ALIGN="LEFT">reservation_id</TD><TD ALIGN="RIGHT"><FONT COLOR="#a0522d">FK</FONT></TD></TR><TR><TD ALIGN="LEFT">maintenance_id</TD><TD ALIGN="RIGHT"><FONT COLOR="#a0522d">FK</FONT></TD></TR><TR><TD ALIGN="LEFT">rate</TD><TD ALIGN="RIGHT"><FONT COLOR="#a0522d"> </FONT></TD></TR></TABLE>>];
  GUEST [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#3b2f2a"><TR><TD COLSPAN="2" BGCOLOR="#3b2f2a"><FONT COLOR="white"><B>GUEST</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="RIGHT"><FONT COLOR="#a0522d">PK</FONT></TD></TR><TR><TD ALIGN="LEFT">first_name</TD><TD ALIGN="RIGHT"><FONT COLOR="#a0522d"> </FONT></TD></TR><TR><TD ALIGN="LEFT">last_name</TD><TD ALIGN="RIGHT"><FONT COLOR="#a0522d"> </FONT></TD></TR><TR><TD ALIGN="LEFT">id_doc_type</TD><TD ALIGN="RIGHT"><FONT COLOR="#a0522d">UQ¹</FONT></TD></TR><TR><TD ALIGN="LEFT">id_doc_number</TD><TD ALIGN="RIGHT"><FONT COLOR="#a0522d">UQ¹</FONT></TD></TR><TR><TD ALIGN="LEFT">nationality</TD><TD ALIGN="RIGHT"><FONT COLOR="#a0522d"> </FONT></TD></TR><TR><TD ALIGN="LEFT">phone</TD><TD ALIGN="RIGHT"><FONT COLOR="#a0522d"> </FONT></TD></TR><TR><TD ALIGN="LEFT">email</TD><TD ALIGN="RIGHT"><FONT COLOR="#a0522d"> </FONT></TD></TR><TR><TD ALIGN="LEFT">is_vip</TD><TD ALIGN="RIGHT"><FONT COLOR="#a0522d"> </FONT></TD></TR><TR><TD ALIGN="LEFT">do_not_rent</TD><TD ALIGN="RIGHT"><FONT COLOR="#a0522d"> </FONT></TD></TR></TABLE>>];
  RESERVATION [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#3b2f2a"><TR><TD COLSPAN="2" BGCOLOR="#3b2f2a"><FONT COLOR="white"><B>RESERVATION</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="RIGHT"><FONT COLOR="#a0522d">PK</FONT></TD></TR><TR><TD ALIGN="LEFT">code</TD><TD ALIGN="RIGHT"><FONT COLOR="#a0522d">UQ</FONT></TD></TR><TR><TD ALIGN="LEFT">guest_id</TD><TD ALIGN="RIGHT"><FONT COLOR="#a0522d">FK</FONT></TD></TR><TR><TD ALIGN="LEFT">arrival</TD><TD ALIGN="RIGHT"><FONT COLOR="#a0522d"> </FONT></TD></TR><TR><TD ALIGN="LEFT">departure</TD><TD ALIGN="RIGHT"><FONT COLOR="#a0522d"> </FONT></TD></TR><TR><TD ALIGN="LEFT">status</TD><TD ALIGN="RIGHT"><FONT COLOR="#a0522d"> </FONT></TD></TR><TR><TD ALIGN="LEFT">cancellation_fee</TD><TD ALIGN="RIGHT"><FONT COLOR="#a0522d"> </FONT></TD></TR><TR><TD ALIGN="LEFT">created_by</TD><TD ALIGN="RIGHT"><FONT COLOR="#a0522d">FK</FONT></TD></TR></TABLE>>];
  RESERVATION_ROOM [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#3b2f2a"><TR><TD COLSPAN="2" BGCOLOR="#3b2f2a"><FONT COLOR="white"><B>RESERVATION_ROOM</B></FONT></TD></TR><TR><TD ALIGN="LEFT">reservation_id</TD><TD ALIGN="RIGHT"><FONT COLOR="#a0522d">PK, FK</FONT></TD></TR><TR><TD ALIGN="LEFT">room_id</TD><TD ALIGN="RIGHT"><FONT COLOR="#a0522d">PK, FK</FONT></TD></TR><TR><TD ALIGN="LEFT">adults</TD><TD ALIGN="RIGHT"><FONT COLOR="#a0522d"> </FONT></TD></TR><TR><TD ALIGN="LEFT">children</TD><TD ALIGN="RIGHT"><FONT COLOR="#a0522d"> </FONT></TD></TR><TR><TD ALIGN="LEFT">moved_out_on</TD><TD ALIGN="RIGHT"><FONT COLOR="#a0522d"> </FONT></TD></TR></TABLE>>];
  EXTRA [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#3b2f2a"><TR><TD COLSPAN="2" BGCOLOR="#3b2f2a"><FONT COLOR="white"><B>EXTRA</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="RIGHT"><FONT COLOR="#a0522d">PK</FONT></TD></TR><TR><TD ALIGN="LEFT">name</TD><TD ALIGN="RIGHT"><FONT COLOR="#a0522d">UQ</FONT></TD></TR><TR><TD ALIGN="LEFT">unit_price</TD><TD ALIGN="RIGHT"><FONT COLOR="#a0522d"> </FONT></TD></TR><TR><TD ALIGN="LEFT">is_active</TD><TD ALIGN="RIGHT"><FONT COLOR="#a0522d"> </FONT></TD></TR></TABLE>>];
  SERVICE_CHARGE [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#3b2f2a"><TR><TD COLSPAN="2" BGCOLOR="#3b2f2a"><FONT COLOR="white"><B>SERVICE_CHARGE</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="RIGHT"><FONT COLOR="#a0522d">PK</FONT></TD></TR><TR><TD ALIGN="LEFT">reservation_id</TD><TD ALIGN="RIGHT"><FONT COLOR="#a0522d">FK</FONT></TD></TR><TR><TD ALIGN="LEFT">extra_id</TD><TD ALIGN="RIGHT"><FONT COLOR="#a0522d">FK</FONT></TD></TR><TR><TD ALIGN="LEFT">quantity</TD><TD ALIGN="RIGHT"><FONT COLOR="#a0522d"> </FONT></TD></TR><TR><TD ALIGN="LEFT">unit_price</TD><TD ALIGN="RIGHT"><FONT COLOR="#a0522d"> </FONT></TD></TR><TR><TD ALIGN="LEFT">charge_date</TD><TD ALIGN="RIGHT"><FONT COLOR="#a0522d"> </FONT></TD></TR></TABLE>>];
  PAYMENT [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#3b2f2a"><TR><TD COLSPAN="2" BGCOLOR="#3b2f2a"><FONT COLOR="white"><B>PAYMENT</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="RIGHT"><FONT COLOR="#a0522d">PK</FONT></TD></TR><TR><TD ALIGN="LEFT">reservation_id</TD><TD ALIGN="RIGHT"><FONT COLOR="#a0522d">FK</FONT></TD></TR><TR><TD ALIGN="LEFT">amount</TD><TD ALIGN="RIGHT"><FONT COLOR="#a0522d"> </FONT></TD></TR><TR><TD ALIGN="LEFT">kind</TD><TD ALIGN="RIGHT"><FONT COLOR="#a0522d"> </FONT></TD></TR><TR><TD ALIGN="LEFT">method</TD><TD ALIGN="RIGHT"><FONT COLOR="#a0522d"> </FONT></TD></TR><TR><TD ALIGN="LEFT">paid_at</TD><TD ALIGN="RIGHT"><FONT COLOR="#a0522d"> </FONT></TD></TR></TABLE>>];
  DISCOUNT [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#3b2f2a"><TR><TD COLSPAN="2" BGCOLOR="#3b2f2a"><FONT COLOR="white"><B>DISCOUNT</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="RIGHT"><FONT COLOR="#a0522d">PK</FONT></TD></TR><TR><TD ALIGN="LEFT">reservation_id</TD><TD ALIGN="RIGHT"><FONT COLOR="#a0522d">FK</FONT></TD></TR><TR><TD ALIGN="LEFT">kind</TD><TD ALIGN="RIGHT"><FONT COLOR="#a0522d"> </FONT></TD></TR><TR><TD ALIGN="LEFT">rate_or_amount</TD><TD ALIGN="RIGHT"><FONT COLOR="#a0522d"> </FONT></TD></TR><TR><TD ALIGN="LEFT">reason</TD><TD ALIGN="RIGHT"><FONT COLOR="#a0522d"> </FONT></TD></TR><TR><TD ALIGN="LEFT">approved_by</TD><TD ALIGN="RIGHT"><FONT COLOR="#a0522d">FK</FONT></TD></TR></TABLE>>];
  TAX_RULE [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#3b2f2a"><TR><TD COLSPAN="2" BGCOLOR="#3b2f2a"><FONT COLOR="white"><B>TAX_RULE</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="RIGHT"><FONT COLOR="#a0522d">PK</FONT></TD></TR><TR><TD ALIGN="LEFT">name</TD><TD ALIGN="RIGHT"><FONT COLOR="#a0522d"> </FONT></TD></TR><TR><TD ALIGN="LEFT">kind</TD><TD ALIGN="RIGHT"><FONT COLOR="#a0522d"> </FONT></TD></TR><TR><TD ALIGN="LEFT">rate_or_amount</TD><TD ALIGN="RIGHT"><FONT COLOR="#a0522d"> </FONT></TD></TR><TR><TD ALIGN="LEFT">applies_to</TD><TD ALIGN="RIGHT"><FONT COLOR="#a0522d"> </FONT></TD></TR><TR><TD ALIGN="LEFT">payers</TD><TD ALIGN="RIGHT"><FONT COLOR="#a0522d"> </FONT></TD></TR></TABLE>>];
  TAX_EXEMPTION [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#3b2f2a"><TR><TD COLSPAN="2" BGCOLOR="#3b2f2a"><FONT COLOR="white"><B>TAX_EXEMPTION</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="RIGHT"><FONT COLOR="#a0522d">PK</FONT></TD></TR><TR><TD ALIGN="LEFT">reservation_id</TD><TD ALIGN="RIGHT"><FONT COLOR="#a0522d">FK</FONT></TD></TR><TR><TD ALIGN="LEFT">tax_rule_id</TD><TD ALIGN="RIGHT"><FONT COLOR="#a0522d">FK</FONT></TD></TR><TR><TD ALIGN="LEFT">reason</TD><TD ALIGN="RIGHT"><FONT COLOR="#a0522d"> </FONT></TD></TR></TABLE>>];
  INVOICE [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#3b2f2a"><TR><TD COLSPAN="2" BGCOLOR="#3b2f2a"><FONT COLOR="white"><B>INVOICE</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="RIGHT"><FONT COLOR="#a0522d">PK</FONT></TD></TR><TR><TD ALIGN="LEFT">number</TD><TD ALIGN="RIGHT"><FONT COLOR="#a0522d">UQ</FONT></TD></TR><TR><TD ALIGN="LEFT">reservation_id</TD><TD ALIGN="RIGHT"><FONT COLOR="#a0522d">FK, UQ</FONT></TD></TR><TR><TD ALIGN="LEFT">issued_at</TD><TD ALIGN="RIGHT"><FONT COLOR="#a0522d"> </FONT></TD></TR><TR><TD ALIGN="LEFT">subtotal, discount, tax</TD><TD ALIGN="RIGHT"><FONT COLOR="#a0522d"> </FONT></TD></TR><TR><TD ALIGN="LEFT">total, paid, balance</TD><TD ALIGN="RIGHT"><FONT COLOR="#a0522d"> </FONT></TD></TR></TABLE>>];
  INVOICE_LINE [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#3b2f2a"><TR><TD COLSPAN="2" BGCOLOR="#3b2f2a"><FONT COLOR="white"><B>INVOICE_LINE</B></FONT></TD></TR><TR><TD ALIGN="LEFT">invoice_id</TD><TD ALIGN="RIGHT"><FONT COLOR="#a0522d">PK, FK</FONT></TD></TR><TR><TD ALIGN="LEFT">line_no</TD><TD ALIGN="RIGHT"><FONT COLOR="#a0522d">PK</FONT></TD></TR><TR><TD ALIGN="LEFT">kind</TD><TD ALIGN="RIGHT"><FONT COLOR="#a0522d"> </FONT></TD></TR><TR><TD ALIGN="LEFT">label</TD><TD ALIGN="RIGHT"><FONT COLOR="#a0522d"> </FONT></TD></TR><TR><TD ALIGN="LEFT">quantity</TD><TD ALIGN="RIGHT"><FONT COLOR="#a0522d"> </FONT></TD></TR><TR><TD ALIGN="LEFT">amount</TD><TD ALIGN="RIGHT"><FONT COLOR="#a0522d"> </FONT></TD></TR></TABLE>>];
  APP_USER [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#3b2f2a"><TR><TD COLSPAN="2" BGCOLOR="#3b2f2a"><FONT COLOR="white"><B>APP_USER</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="RIGHT"><FONT COLOR="#a0522d">PK</FONT></TD></TR><TR><TD ALIGN="LEFT">username</TD><TD ALIGN="RIGHT"><FONT COLOR="#a0522d">UQ</FONT></TD></TR><TR><TD ALIGN="LEFT">full_name</TD><TD ALIGN="RIGHT"><FONT COLOR="#a0522d"> </FONT></TD></TR><TR><TD ALIGN="LEFT">role</TD><TD ALIGN="RIGHT"><FONT COLOR="#a0522d"> </FONT></TD></TR><TR><TD ALIGN="LEFT">is_active</TD><TD ALIGN="RIGHT"><FONT COLOR="#a0522d"> </FONT></TD></TR></TABLE>>];
  AUDIT_LOG [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#3b2f2a"><TR><TD COLSPAN="2" BGCOLOR="#3b2f2a"><FONT COLOR="white"><B>AUDIT_LOG</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="RIGHT"><FONT COLOR="#a0522d">PK</FONT></TD></TR><TR><TD ALIGN="LEFT">user_id</TD><TD ALIGN="RIGHT"><FONT COLOR="#a0522d">FK</FONT></TD></TR><TR><TD ALIGN="LEFT">at</TD><TD ALIGN="RIGHT"><FONT COLOR="#a0522d"> </FONT></TD></TR><TR><TD ALIGN="LEFT">action</TD><TD ALIGN="RIGHT"><FONT COLOR="#a0522d"> </FONT></TD></TR><TR><TD ALIGN="LEFT">entity</TD><TD ALIGN="RIGHT"><FONT COLOR="#a0522d"> </FONT></TD></TR><TR><TD ALIGN="LEFT">prev_hash</TD><TD ALIGN="RIGHT"><FONT COLOR="#a0522d"> </FONT></TD></TR><TR><TD ALIGN="LEFT">hash</TD><TD ALIGN="RIGHT"><FONT COLOR="#a0522d"> </FONT></TD></TR></TABLE>>];
  ROOM_CATEGORY -> ROOM [arrowtail=teetee, arrowhead=crowodot, label=" classifies "];
  ROOM_CATEGORY -> RATE_PERIOD [arrowtail=teetee, arrowhead=crowodot, label=" is priced by "];
  ROOM -> MAINTENANCE [arrowtail=teetee, arrowhead=crowodot, label=" is closed by "];
  ROOM -> ROOM_NIGHT [arrowtail=teetee, arrowhead=crowodot, label=" is occupied on "];
  ROOM -> RESERVATION_ROOM [arrowtail=teetee, arrowhead=crowodot, label=" is booked in "];
  GUEST -> RESERVATION [arrowtail=teetee, arrowhead=crowodot, label=" makes "];
  RESERVATION -> RESERVATION_ROOM [arrowtail=teetee, arrowhead=crowtee, label=" includes "];
  RESERVATION -> ROOM_NIGHT [arrowtail=teeodot, arrowhead=crowodot, label=" holds "];
  MAINTENANCE -> ROOM_NIGHT [arrowtail=teeodot, arrowhead=crowodot, label=" blocks "];
  RESERVATION -> SERVICE_CHARGE [arrowtail=teetee, arrowhead=crowodot, label=" accrues "];
  EXTRA -> SERVICE_CHARGE [arrowtail=teetee, arrowhead=crowodot, label=" is billed as "];
  RESERVATION -> PAYMENT [arrowtail=teetee, arrowhead=crowodot, label=" receives "];
  RESERVATION -> DISCOUNT [arrowtail=teetee, arrowhead=crowodot, label=" is granted "];
  RESERVATION -> TAX_EXEMPTION [arrowtail=teetee, arrowhead=crowodot, label=" is exempted by "];
  TAX_RULE -> TAX_EXEMPTION [arrowtail=teetee, arrowhead=crowodot, label=" is waived by "];
  RESERVATION -> INVOICE [arrowtail=teetee, arrowhead=teeodot, label=" is closed by "];
  INVOICE -> INVOICE_LINE [arrowtail=teetee, arrowhead=crowtee, label=" contains "];
  APP_USER -> RESERVATION [arrowtail=teetee, arrowhead=crowodot, label=" creates "];
  APP_USER -> AUDIT_LOG [arrowtail=teeodot, arrowhead=crowodot, label=" performs "];
}
