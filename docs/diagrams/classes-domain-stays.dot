    TaxRule [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#a0522d" BGCOLOR="#fdf6ee"><TR><TD><FONT POINT-SIZE="8">«entity»</FONT></TD></TR><TR><TD><B><I>TaxRule</I></B></TD></TR><TR><TD><FONT POINT-SIZE="8">{abstract}</FONT></TD></TR><TR><TD SIDES="T" COLOR="#a0522d" ALIGN="LEFT" BALIGN="LEFT">id: int | None<BR ALIGN="LEFT"/>name: str<BR ALIGN="LEFT"/>applies_to: TaxBase<BR ALIGN="LEFT"/>payers: TaxPayers<BR ALIGN="LEFT"/>is_active: bool<BR ALIGN="LEFT"/>version: int<BR ALIGN="LEFT"/>archived_at: datetime | None<BR ALIGN="LEFT"/>/is_archived: bool<BR ALIGN="LEFT"/>/kind: TaxKind<BR ALIGN="LEFT"/></TD></TR><TR><TD SIDES="T" COLOR="#a0522d" ALIGN="LEFT" BALIGN="LEFT">+concerns(national): bool<BR ALIGN="LEFT"/>+amount(stay): Money<BR ALIGN="LEFT"/>+basis(stay): tuple[int, Money]<BR ALIGN="LEFT"/>+validate(): None<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    PercentTax [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#a0522d" BGCOLOR="#fdf6ee"><TR><TD><FONT POINT-SIZE="8">«entity»</FONT></TD></TR><TR><TD><B>PercentTax</B></TD></TR><TR><TD SIDES="T" COLOR="#a0522d" ALIGN="LEFT" BALIGN="LEFT">rate_bp: int<BR ALIGN="LEFT"/>/kind: TaxKind<BR ALIGN="LEFT"/></TD></TR><TR><TD SIDES="T" COLOR="#a0522d" ALIGN="LEFT" BALIGN="LEFT">+amount(stay): Money<BR ALIGN="LEFT"/>+basis(stay): tuple[int, Money]<BR ALIGN="LEFT"/>+validate(): None<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    PerAdultNightTax [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#a0522d" BGCOLOR="#fdf6ee"><TR><TD><FONT POINT-SIZE="8">«entity»</FONT></TD></TR><TR><TD><B>PerAdultNightTax</B></TD></TR><TR><TD SIDES="T" COLOR="#a0522d" ALIGN="LEFT" BALIGN="LEFT">amount_per: Money<BR ALIGN="LEFT"/>/kind: TaxKind<BR ALIGN="LEFT"/></TD></TR><TR><TD SIDES="T" COLOR="#a0522d" ALIGN="LEFT" BALIGN="LEFT">+amount(stay): Money<BR ALIGN="LEFT"/>+basis(stay): tuple[int, Money]<BR ALIGN="LEFT"/>+validate(): None<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    TaxBase [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#a0522d" BGCOLOR="#fdf6ee"><TR><TD><FONT POINT-SIZE="8">«enumeration»</FONT></TD></TR><TR><TD><B>TaxBase</B></TD></TR><TR><TD SIDES="T" COLOR="#a0522d" ALIGN="LEFT" BALIGN="LEFT">ACCOMMODATION<BR ALIGN="LEFT"/>SERVICES<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    TaxPayers [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#a0522d" BGCOLOR="#fdf6ee"><TR><TD><FONT POINT-SIZE="8">«enumeration»</FONT></TD></TR><TR><TD><B>TaxPayers</B></TD></TR><TR><TD SIDES="T" COLOR="#a0522d" ALIGN="LEFT" BALIGN="LEFT">EVERYONE<BR ALIGN="LEFT"/>FOREIGN<BR ALIGN="LEFT"/>NATIONALS<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    TaxKind [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#a0522d" BGCOLOR="#fdf6ee"><TR><TD><FONT POINT-SIZE="8">«enumeration»</FONT></TD></TR><TR><TD><B>TaxKind</B></TD></TR><TR><TD SIDES="T" COLOR="#a0522d" ALIGN="LEFT" BALIGN="LEFT">PERCENT<BR ALIGN="LEFT"/>PER_ADULT_NIGHT<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    TaxableStay [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#a0522d" BGCOLOR="#fdf6ee"><TR><TD><FONT POINT-SIZE="8">«value object»</FONT></TD></TR><TR><TD><B>TaxableStay</B></TD></TR><TR><TD SIDES="T" COLOR="#a0522d" ALIGN="LEFT" BALIGN="LEFT">accommodation: Money<BR ALIGN="LEFT"/>services: Money<BR ALIGN="LEFT"/>adult_nights: int<BR ALIGN="LEFT"/></TD></TR><TR><TD SIDES="T" COLOR="#a0522d" ALIGN="LEFT" BALIGN="LEFT"> <BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    TaxExemption [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#a0522d" BGCOLOR="#fdf6ee"><TR><TD><FONT POINT-SIZE="8">«entity»</FONT></TD></TR><TR><TD><B>TaxExemption</B></TD></TR><TR><TD SIDES="T" COLOR="#a0522d" ALIGN="LEFT" BALIGN="LEFT">id: int | None<BR ALIGN="LEFT"/>reservation_id: int<BR ALIGN="LEFT"/>tax_rule_id: int<BR ALIGN="LEFT"/>reason: str<BR ALIGN="LEFT"/>created_at: datetime | None<BR ALIGN="LEFT"/>created_by_name: str<BR ALIGN="LEFT"/>tax_name: str<BR ALIGN="LEFT"/></TD></TR><TR><TD SIDES="T" COLOR="#a0522d" ALIGN="LEFT" BALIGN="LEFT">+validate(): None<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  }
  Reservation -> Guest [arrowhead=vee, label="booked for", taillabel="*", headlabel="1"];
  Reservation -> BookedRoom [dir=back, arrowtail=diamond, taillabel="1", headlabel="1..*"];
  Reservation -> RoomNight [dir=back, arrowtail=diamond, label="nights (price locked)", taillabel="1", headlabel="1..*"];
  Reservation -> StayPeriod [dir=back, arrowtail=diamond, label="period", headlabel="1"];
  Reservation -> ReservationStatus [arrowhead=vee, label="status"];
  BookedRoom -> Room [arrowhead=vee, taillabel="*", headlabel="1"];
  RoomNight -> Room [arrowhead=vee, taillabel="*", headlabel="1"];
  Room -> RoomCategory [arrowhead=vee, taillabel="*", headlabel="1"];
  Room -> Housekeeping [arrowhead=vee, label="housekeeping"];
  MaintenancePeriod -> Room [arrowhead=vee, label="closes", taillabel="*", headlabel="1"];
  RatePeriod -> RoomCategory [arrowhead=vee, taillabel="*", headlabel="1"];
  Pricing -> RatePeriod [dir=back, arrowtail=odiamond, headlabel="*"];
  HotelSettings -> CancellationPolicy [style=dashed, arrowhead=vee, label="«create»"];
  Guest -> IdDocType [arrowhead=vee, label="id_doc_type"];
  ServiceCharge -> Reservation [arrowhead=vee, taillabel="*", headlabel="1"];
  ServiceCharge -> Extra [arrowhead=vee, label="copies price of", taillabel="*", headlabel="1"];
  Payment -> Reservation [arrowhead=vee, taillabel="*", headlabel="1"];
  Payment -> PaymentKind [arrowhead=vee];
  Payment -> PaymentMethod [arrowhead=vee];
  Discount -> Reservation [arrowhead=vee, taillabel="*", headlabel="1"];
  PercentDiscount -> Discount [arrowhead=onormal, arrowsize=1.1];
  FixedDiscount -> Discount [arrowhead=onormal, arrowsize=1.1];
  Bill -> BillLine [dir=back, arrowtail=diamond, taillabel="1", headlabel="*"];
  Bill -> Payment [dir=back, arrowtail=odiamond, headlabel="*"];
  BillLine -> LineKind [arrowhead=vee, label="kind"];
  Invoice -> Reservation [arrowhead=vee, label="issued for", taillabel="0..1", headlabel="1"];
  Invoice -> BillLine [dir=back, arrowtail=diamond, label="frozen copy", taillabel="1", headlabel="*"];
  Invoice -> Bill [style=dashed, arrowhead=vee, label="«create»"];
  PercentTax -> TaxRule [arrowhead=onormal, arrowsize=1.1];
  PerAdultNightTax -> TaxRule [arrowhead=onormal, arrowsize=1.1];
  TaxRule -> TaxBase [arrowhead=vee, label="applies_to"];
  TaxRule -> TaxPayers [arrowhead=vee, label="payers"];
  TaxRule -> TaxKind [arrowhead=vee, label="kind"];
  TaxRule -> TaxableStay [style=dashed, arrowhead=vee, label="«use»"];
  TaxExemption -> Reservation [arrowhead=vee, taillabel="*", headlabel="1"];
  TaxExemption -> TaxRule [arrowhead=vee, taillabel="*", headlabel="1"];
  note [shape=note, style=filled, fillcolor="#ffffff", color="#b9aa98", fontsize=9, label="Money (integer millimes) is the type of every amount.\lbuild_bill() turns a Reservation, its charges, discounts, applicable\ltaxes and payments into a Bill; an Invoice freezes its lines.\lIds (guest_id, room_id...) are the associations drawn as lines.\l"];
}
