digraph architecture {
  // Generated by docs/diagrams/class_diagrams.py from the source code: do not edit by hand.
  graph [fontname="Helvetica", fontsize=13, rankdir=TB, nodesep=0.35, ranksep=0.55,
         pad=0.3, bgcolor="white", newrank=true, label=<<B>Architecture: layers and their classes</B>>, labelloc=t];
  node  [shape=plain, fontname="Helvetica", fontsize=9];
  edge  [fontname="Helvetica", fontsize=8.5, color="#3b2f2a", fontcolor="#3b2f2a", arrowsize=0.8];
  subgraph cluster_web {
    label="web/  (HTTP, forms, pages, JSON API)"; style="rounded,dashed"; color="#b9aa98"; fontsize=11;
    Blueprints [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#a0522d" BGCOLOR="#f3e7da"><TR><TD><FONT POINT-SIZE="8">«Flask blueprints (one per area)»</FONT></TD></TR><TR><TD><B>Blueprints</B></TD></TR><TR><TD SIDES="T" COLOR="#a0522d" ALIGN="LEFT" BALIGN="LEFT">account, api, audit, auth<BR ALIGN="LEFT"/>availability, backups, billing, dashboard<BR ALIGN="LEFT"/>extras, guests, health, help<BR ALIGN="LEFT"/>hotel_settings, invoices, night_audit, preferences<BR ALIGN="LEFT"/>reports, reservations, rooms, staff<BR ALIGN="LEFT"/>welcome<BR ALIGN="LEFT"/></TD></TR><TR><TD SIDES="T" COLOR="#a0522d" ALIGN="LEFT" BALIGN="LEFT"> <BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    AccessPolicy [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#a0522d" BGCOLOR="#fdf6ee"><TR><TD><FONT POINT-SIZE="8">«deny by default»</FONT></TD></TR><TR><TD><B>AccessPolicy</B></TD></TR><TR><TD SIDES="T" COLOR="#a0522d" ALIGN="LEFT" BALIGN="LEFT">public: bool<BR ALIGN="LEFT"/>roles: frozenset[Role] | None<BR ALIGN="LEFT"/>api: bool<BR ALIGN="LEFT"/></TD></TR><TR><TD SIDES="T" COLOR="#a0522d" ALIGN="LEFT" BALIGN="LEFT"> <BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    RateLimiter [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#a0522d" BGCOLOR="#fdf6ee"><TR><TD><B>RateLimiter</B></TD></TR><TR><TD SIDES="T" COLOR="#a0522d" ALIGN="LEFT" BALIGN="LEFT"> <BR ALIGN="LEFT"/></TD></TR><TR><TD SIDES="T" COLOR="#a0522d" ALIGN="LEFT" BALIGN="LEFT">+hit(key, now): int<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    Templates [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#a0522d" BGCOLOR="#f3e7da"><TR><TD><FONT POINT-SIZE="8">«Jinja2 + CSS, no JavaScript»</FONT></TD></TR><TR><TD><B>Templates</B></TD></TR><TR><TD SIDES="T" COLOR="#a0522d" ALIGN="LEFT" BALIGN="LEFT">autoescaped HTML, EN / FR / AR (RTL)<BR ALIGN="LEFT"/>strict Content-Security-Policy<BR ALIGN="LEFT"/></TD></TR><TR><TD SIDES="T" COLOR="#a0522d" ALIGN="LEFT" BALIGN="LEFT"> <BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  }
  subgraph cluster_services {
    label="services/  (use cases)"; style="rounded,dashed"; color="#b9aa98"; fontsize=11;
    Services [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#a0522d" BGCOLOR="#fdf6ee"><TR><TD><FONT POINT-SIZE="8">«composition root (bootstrap)»</FONT></TD></TR><TR><TD><B>Services</B></TD></TR><TR><TD SIDES="T" COLOR="#a0522d" ALIGN="LEFT" BALIGN="LEFT">settings: Settings<BR ALIGN="LEFT"/>clock: Clock<BR ALIGN="LEFT"/>uow_factory: UnitOfWorkFactory<BR ALIGN="LEFT"/>schema_version: int<BR ALIGN="LEFT"/>auth: AuthService<BR ALIGN="LEFT"/>audit: AuditService<BR ALIGN="LEFT"/>users: UserService<BR ALIGN="LEFT"/>rooms: RoomService<BR ALIGN="LEFT"/>guests: GuestService<BR ALIGN="LEFT"/>backups: BackupService<BR ALIGN="LEFT"/>reservations: ReservationService<BR ALIGN="LEFT"/>form_tokens: FormTokenService<BR ALIGN="LEFT"/>front_desk: FrontDeskService<BR ALIGN="LEFT"/>extras: ExtrasService<BR ALIGN="LEFT"/>hotel_settings: HotelSettingsService<BR ALIGN="LEFT"/>billing: BillingService<BR ALIGN="LEFT"/>invoices: InvoiceService<BR ALIGN="LEFT"/>reports: ReportService<BR ALIGN="LEFT"/>night_audit: NightAuditService<BR ALIGN="LEFT"/>two_factor: TwoFactorService<BR ALIGN="LEFT"/>api_tokens: ApiTokenService<BR ALIGN="LEFT"/>onboarding: OnboardingService<BR ALIGN="LEFT"/></TD></TR><TR><TD SIDES="T" COLOR="#a0522d" ALIGN="LEFT" BALIGN="LEFT">+is_healthy(): bool<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    ApplicationServices [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#a0522d" BGCOLOR="#f3e7da"><TR><TD><FONT POINT-SIZE="8">«services (role checks, transactions, audit)»</FONT></TD></TR><TR><TD><B>ApplicationServices</B></TD></TR><TR><TD SIDES="T" COLOR="#a0522d" ALIGN="LEFT" BALIGN="LEFT">ApiTokenService<BR ALIGN="LEFT"/>AuditService<BR ALIGN="LEFT"/>AuthService<BR ALIGN="LEFT"/>BackupService<BR ALIGN="LEFT"/>BillingService<BR ALIGN="LEFT"/>ExtrasService<BR ALIGN="LEFT"/>FormTokenService<BR ALIGN="LEFT"/>FrontDeskService<BR ALIGN="LEFT"/>GuestService<BR ALIGN="LEFT"/>HotelSettingsService<BR ALIGN="LEFT"/>InvoiceService<BR ALIGN="LEFT"/>NightAuditService<BR ALIGN="LEFT"/>OnboardingService<BR ALIGN="LEFT"/>ReportService<BR ALIGN="LEFT"/>ReservationService<BR ALIGN="LEFT"/>RoomService<BR ALIGN="LEFT"/>TwoFactorService<BR ALIGN="LEFT"/>UserService<BR ALIGN="LEFT"/></TD></TR><TR><TD SIDES="T" COLOR="#a0522d" ALIGN="LEFT" BALIGN="LEFT"> <BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    PasswordHasher [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#a0522d" BGCOLOR="#fdf6ee"><TR><TD><FONT POINT-SIZE="8">«scrypt»</FONT></TD></TR><TR><TD><B>PasswordHasher</B></TD></TR><TR><TD SIDES="T" COLOR="#a0522d" ALIGN="LEFT" BALIGN="LEFT"> <BR ALIGN="LEFT"/></TD></TR><TR><TD SIDES="T" COLOR="#a0522d" ALIGN="LEFT" BALIGN="LEFT">+hash(password): str<BR ALIGN="LEFT"/>+verify(password, encoded): bool<BR ALIGN="LEFT"/>+verify_dummy(password): None<BR ALIGN="LEFT"/>+needs_rehash(encoded): bool<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  }
  subgraph cluster_domain {
    label="domain/  (pure Python: rules, no database, no web)"; style="rounded,dashed"; color="#b9aa98"; fontsize=11;
    DomainModel [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#a0522d" BGCOLOR="#fdf6ee"><TR><TD><FONT POINT-SIZE="8">«entities, value objects, policies»</FONT></TD></TR><TR><TD><B>DomainModel</B></TD></TR><TR><TD SIDES="T" COLOR="#a0522d" ALIGN="LEFT" BALIGN="LEFT">Reservation, Guest, Room, Bill, Invoice, TaxRule...<BR ALIGN="LEFT"/>see the two domain class diagrams<BR ALIGN="LEFT"/></TD></TR><TR><TD SIDES="T" COLOR="#a0522d" ALIGN="LEFT" BALIGN="LEFT"> <BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  }
  subgraph cluster_persistence {
    label="persistence/  (SQLite, migrations, backups)"; style="rounded,dashed"; color="#b9aa98"; fontsize=11;
    UnitOfWork [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#a0522d" BGCOLOR="#fdf6ee"><TR><TD><FONT POINT-SIZE="8">«one transaction (BEGIN IMMEDIATE)»</FONT></TD></TR><TR><TD><B>UnitOfWork</B></TD></TR><TR><TD SIDES="T" COLOR="#a0522d" ALIGN="LEFT" BALIGN="LEFT">audit: AuditRepository<BR ALIGN="LEFT"/>users: UserRepository<BR ALIGN="LEFT"/>sessions: SessionRepository<BR ALIGN="LEFT"/>login_failures: LoginFailureRepository<BR ALIGN="LEFT"/>categories: CategoryRepository<BR ALIGN="LEFT"/>rooms: RoomRepository<BR ALIGN="LEFT"/>maintenance: MaintenanceRepository<BR ALIGN="LEFT"/>guests: GuestRepository<BR ALIGN="LEFT"/>settings: SettingRepository<BR ALIGN="LEFT"/>reservations: ReservationRepository<BR ALIGN="LEFT"/>counters: CounterRepository<BR ALIGN="LEFT"/>form_tokens: FormTokenRepository<BR ALIGN="LEFT"/>extras: ExtraRepository<BR ALIGN="LEFT"/>charges: ServiceChargeRepository<BR ALIGN="LEFT"/>tax_rules: TaxRuleRepository<BR ALIGN="LEFT"/>discounts: DiscountRepository<BR ALIGN="LEFT"/>payments: PaymentRepository<BR ALIGN="LEFT"/>invoices: InvoiceRepository<BR ALIGN="LEFT"/>reports: ReportRepository<BR ALIGN="LEFT"/>snapshots: SnapshotRepository<BR ALIGN="LEFT"/>rate_periods: RatePeriodRepository<BR ALIGN="LEFT"/>recovery_codes: RecoveryCodeRepository<BR ALIGN="LEFT"/>login_challenges: LoginChallengeRepository<BR ALIGN="LEFT"/>api_tokens: ApiTokenRepository<BR ALIGN="LEFT"/>onboarding: OnboardingRepository<BR ALIGN="LEFT"/>tax_exemptions: TaxExemptionRepository<BR ALIGN="LEFT"/></TD></TR><TR><TD SIDES="T" COLOR="#a0522d" ALIGN="LEFT" BALIGN="LEFT"> <BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    Repositories [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#a0522d" BGCOLOR="#f3e7da"><TR><TD><FONT POINT-SIZE="8">«repositories (SQL with ? parameters)»</FONT></TD></TR><TR><TD><B>Repositories</B></TD></TR><TR><TD SIDES="T" COLOR="#a0522d" ALIGN="LEFT" BALIGN="LEFT">ApiTokenRepository<BR ALIGN="LEFT"/>AuditRepository<BR ALIGN="LEFT"/>CategoryRepository<BR ALIGN="LEFT"/>CounterRepository<BR ALIGN="LEFT"/>DiscountRepository<BR ALIGN="LEFT"/>ExtraRepository<BR ALIGN="LEFT"/>FormTokenRepository<BR ALIGN="LEFT"/>GuestRepository<BR ALIGN="LEFT"/>InvoiceRepository<BR ALIGN="LEFT"/>LoginChallengeRepository<BR ALIGN="LEFT"/>LoginFailureRepository<BR ALIGN="LEFT"/>MaintenanceRepository<BR ALIGN="LEFT"/>OnboardingRepository<BR ALIGN="LEFT"/>PaymentRepository<BR ALIGN="LEFT"/>RatePeriodRepository<BR ALIGN="LEFT"/>RecoveryCodeRepository<BR ALIGN="LEFT"/>ReportRepository<BR ALIGN="LEFT"/>ReservationRepository<BR ALIGN="LEFT"/>RoomRepository<BR ALIGN="LEFT"/>ServiceChargeRepository<BR ALIGN="LEFT"/>SessionRepository<BR ALIGN="LEFT"/>SettingRepository<BR ALIGN="LEFT"/>SnapshotRepository<BR ALIGN="LEFT"/>TaxExemptionRepository<BR ALIGN="LEFT"/>TaxRuleRepository<BR ALIGN="LEFT"/>UserRepository<BR ALIGN="LEFT"/></TD></TR><TR><TD SIDES="T" COLOR="#a0522d" ALIGN="LEFT" BALIGN="LEFT"> <BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    BaseRepository [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#a0522d" BGCOLOR="#fdf6ee"><TR><TD><B>BaseRepository</B></TD></TR><TR><TD SIDES="T" COLOR="#a0522d" ALIGN="LEFT" BALIGN="LEFT"> <BR ALIGN="LEFT"/></TD></TR><TR><TD SIDES="T" COLOR="#a0522d" ALIGN="LEFT" BALIGN="LEFT"> <BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  }
  sqlite [shape=cylinder, style=filled, fillcolor="#ffffff", color="#a0522d", fontsize=10, label="hotel.db\n(SQLite, WAL)"];
  cli [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#a0522d", fontsize=10, label="cli.py\n(hotel ... commands)"];
  Blueprints -> AccessPolicy [style=dashed, arrowhead=vee, label="«declares»"];
  Blueprints -> Services [style=dashed, arrowhead=vee, label="«call»"];
  cli -> Services [style=dashed, arrowhead=vee, label="«call»"];
  Services -> ApplicationServices [dir=back, arrowtail=diamond, taillabel="1", headlabel="*"];
  ApplicationServices -> DomainModel [style=dashed, arrowhead=vee, label="«use»"];
  ApplicationServices -> UnitOfWork [style=dashed, arrowhead=vee, label="«open»"];
  ApplicationServices -> PasswordHasher [style=dashed, arrowhead=vee, label="«use»"];
  UnitOfWork -> Repositories [dir=back, arrowtail=diamond, taillabel="1", headlabel="*"];
  Repositories -> BaseRepository [arrowhead=onormal, arrowsize=1.1];
  Repositories -> DomainModel [style=dashed, arrowhead=vee, label="«map rows to»"];
  UnitOfWork -> sqlite [style=dashed, arrowhead=vee, label="«connect»"];
  Blueprints -> Templates [style=dashed, arrowhead=vee, label="«render»"];
  Blueprints -> RateLimiter [style=dashed, arrowhead=vee, label="«API»"];
}
