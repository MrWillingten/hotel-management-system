msgid "Cancelled: %(c)s · no-shows: %(n)s"
msgstr "Annulées : %(c)s · non-présentations : %(n)s"

#, python-format
msgid "Cancelling now is free (free until %(when)s)."
msgstr "Annuler maintenant est gratuit (jusqu'au %(when)s)."

msgid "Cancelling within this time after booking is always free."
msgstr "Annuler dans ce délai après la réservation est toujours gratuit."

msgid "Cannot scan? Type this key instead:"
msgstr "Impossible de scanner ? Saisissez plutôt cette clé :"

msgid "Capacity"
msgstr "Capacité"

