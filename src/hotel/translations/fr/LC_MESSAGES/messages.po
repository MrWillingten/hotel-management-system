msgstr "« Impayés après départ » liste les factures encore dues."

msgid "Untick to take the room out of service (it can no longer be booked)."
msgstr "Décochez pour mettre la chambre hors service (elle ne peut plus être réservée)."

#, python-format
msgid "Unused recovery codes: %(n)s"
msgstr "Codes de secours inutilisés : %(n)s"

msgid "Up to 3 decimals, for example 15 or 12.500."
msgstr "Jusqu'à 3 décimales, par exemple 15 ou 12,500."

msgid "Up to 3 decimals, for example 180 or 180.500."
msgstr "Jusqu'à 3 décimales, par exemple 180 ou 180,500."

#, python-format
