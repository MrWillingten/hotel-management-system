msgstr ""
"VIP pour une attention particulière ; « Ne pas louer » (gérants) refuse les nouvelles "
"réservations."

msgid "VIP guest"
msgstr "Client VIP"

msgid "Valid for"
msgstr "Valable pendant"

msgid "Value"
msgstr "Valeur"

