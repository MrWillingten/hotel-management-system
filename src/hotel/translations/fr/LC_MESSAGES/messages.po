#, python-format
msgid "%(greeting)s, %(name)s"
msgstr "%(greeting)s, %(name)s"

msgid "Access denied"
msgstr "Accès refusé"

msgid "Amounts have at most 3 decimals (millimes)."
msgstr "Les montants ont au plus 3 décimales (millimes)."

msgid "An unexpected error occurred. It has been logged."
msgstr "Une erreur inattendue s'est produite. Elle a été enregistrée."

msgid "Back to the dashboard"
msgstr "Retour au tableau de bord"

msgid "Bad request"
msgstr "Requête invalide"

msgid "Colour theme"
msgstr "Thème de couleurs"

msgid "Create the first manager account from a terminal, in the project folder:"
msgstr "Créez le premier compte gestionnaire depuis un terminal, dans le dossier du projet :"

msgid "Dark"
msgstr "Sombre"

msgid "Dashboard"
msgstr "Tableau de bord"

msgid "Database schema"
msgstr "Schéma de la base"

msgid "Done"
msgstr "Terminé"

msgid "Enter a name of 1 to 100 characters."
msgstr "Saisissez un nom de 1 à 100 caractères."

msgid "Enter an amount such as 180 or 180.500."
msgstr "Saisissez un montant comme 180 ou 180.500."

msgid "Form expired"
msgstr "Formulaire expiré"

msgid "Foundations: sign-in, themes, languages"
msgstr "Fondations : connexion, thèmes, langues"

msgid "Front desk and billing"
msgstr "Réception et facturation"

msgid "Good afternoon"
msgstr "Bon après-midi"

msgid "Good evening"
msgstr "Bonsoir"

msgid "Good morning"
msgstr "Bonjour"

msgid "Hardening, report and demo"
msgstr "Consolidation, rapport et démonstration"

msgid "Hotel time"
msgstr "Heure de l'hôtel"

msgid "Incident reference:"
msgstr "Référence de l'incident :"

msgid "Invalid username or password, or the account is temporarily locked."
msgstr "Nom d'utilisateur ou mot de passe incorrect, ou compte temporairement verrouillé."

msgid "Language"
msgstr "Langue"

msgid "Light"
msgstr "Clair"

msgid "Main"
msgstr "Principal"

msgid "Manager"
msgstr "Gestionnaire"

msgid "Match system"
msgstr "Selon le système"

msgid "Next"
msgstr "Prochain"

msgid "No account exists yet."
msgstr "Aucun compte n'existe encore."

msgid "Not allowed"
msgstr "Non autorisé"

msgid "Page not found"
msgstr "Page introuvable"

msgid "Password"
msgstr "Mot de passe"

msgid "Planned"
msgstr "Prévu"

msgid "Project roadmap"
msgstr "Feuille de route du projet"

msgid "Reception and management"
msgstr "Réception et gestion"

msgid "Receptionist"
msgstr "Réceptionniste"

msgid "Reports, operations and translations"
msgstr "Rapports, exploitation et traductions"

msgid "Reservations and availability"
msgstr "Réservations et disponibilités"

msgid "Rooms, guests, staff and audit log"
msgstr "Chambres, clients, personnel et journal d'audit"

msgid "Sign in"
msgstr "Se connecter"

msgid "Sign out"
msgstr "Se déconnecter"

msgid "Skip to content"
msgstr "Aller au contenu"

msgid "Some fields need your attention."
msgstr "Certains champs doivent être corrigés."

msgid "Someone else changed this record. Reload the page to see their changes."
msgstr "Quelqu'un d'autre a modifié cet enregistrement. Rechargez la page pour voir ses modifications."

msgid "Something went wrong"
msgstr "Un problème est survenu"

msgid "Something went wrong. Try again."
msgstr "Un problème est survenu. Réessayez."

msgid "System"
msgstr "Système"

msgid "The data sent was too large."
msgstr "Les données envoyées sont trop volumineuses."

msgid "The departure date must be after the arrival date."
msgstr "La date de départ doit être postérieure à la date d'arrivée."

msgid "The first manager account already exists."
msgstr "Le premier compte gestionnaire existe déjà."

msgid "The front desk figures will appear here once reservations are available."
msgstr "Les indicateurs de la réception apparaîtront ici dès que les réservations seront disponibles."

msgid "The page you asked for doesn't exist."
msgstr "La page demandée n'existe pas."

msgid "The password must not contain the username."
msgstr "Le mot de passe ne doit pas contenir le nom d'utilisateur."

msgid "The request couldn't be understood."
msgstr "La requête n'a pas pu être comprise."

msgid "This action can't be done this way."
msgstr "Cette action ne peut pas être effectuée de cette façon."

msgid "This change conflicts with existing data."
msgstr "Cette modification est en conflit avec des données existantes."

msgid "This form expired or was sent from another site. Reload the page and try again."
msgstr "Ce formulaire a expiré ou a été envoyé depuis un autre site. Rechargez la page et réessayez."

msgid "This operation isn't allowed."
msgstr "Cette opération n'est pas autorisée."

msgid "This operation isn't possible in the record's current state."
msgstr "Cette opération est impossible dans l'état actuel de l'enregistrement."

msgid "This password is too common. Choose a less predictable one."
msgstr "Ce mot de passe est trop courant. Choisissez-en un moins prévisible."

msgid "This password repeats the same characters too much."
msgstr "Ce mot de passe répète trop les mêmes caractères."

#, python-format
msgid "Time zone: %(tz)s"
msgstr "Fuseau horaire : %(tz)s"

msgid "Too large"
msgstr "Trop volumineux"

msgid "Too many failed sign-in attempts from this computer. Wait a few minutes and try again."
msgstr ""
"Trop de tentatives de connexion échouées depuis cet ordinateur. Patientez quelques minutes, puis "
"réessayez."

msgid "Use 3 to 32 characters: letters, digits, dots, hyphens or underscores."
msgstr "Utilisez 3 à 32 caractères : lettres, chiffres, points, tirets ou tirets bas."

#, python-format
msgid "Use at least %(min_length)s characters."
msgstr "Utilisez au moins %(min_length)s caractères."

#, python-format
msgid "Use at most %(max_length)s characters."
msgstr "Utilisez au plus %(max_length)s caractères."

msgid "Use the account your manager created for you."
msgstr "Utilisez le compte que votre gestionnaire a créé pour vous."

msgid "Username"
msgstr "Nom d'utilisateur"

msgid "Version"
msgstr "Version"

msgid "We couldn't find what you were looking for."
msgstr "Nous n'avons pas trouvé ce que vous cherchez."

#, python-format
msgid "Welcome, %(name)s."
msgstr "Bienvenue, %(name)s."

msgid "You don't have permission to do that."
msgstr "Vous n'avez pas l'autorisation d'effectuer cette action."

msgid "You don't have permission to open this page."
msgstr "Vous n'avez pas l'autorisation d'ouvrir cette page."

msgid "You have been signed out."
msgstr "Vous avez été déconnecté."

#, python-format
msgid "You'll be signed out after %(minutes)s minutes without activity."
msgstr "Vous serez déconnecté après %(minutes)s minutes d'inactivité."

msgid "Your session"
msgstr "Votre session"
