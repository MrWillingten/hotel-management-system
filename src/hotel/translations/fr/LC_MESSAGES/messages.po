msgid "3 to 32 characters: letters, digits, dots, hyphens or underscores."
msgstr "3 à 32 caractères : lettres, chiffres, points, tirets ou tirets bas."

msgid "A CIN number has exactly 8 digits."
msgstr "Un numéro de CIN comporte exactement 8 chiffres."

msgid "A backup is taken automatically every day when the application starts, and before every upgrade."
msgstr ""
"Une sauvegarde est faite automatiquement chaque jour au démarrage de l'application, et avant "
"chaque mise à jour."

msgid "A category with this name already exists."
msgstr "Une catégorie porte déjà ce nom."

msgid "A guest with the same name and phone or e-mail already exists."
msgstr "Un client portant le même nom et le même téléphone ou e-mail existe déjà."

msgid "A guest with this identity document is already registered."
msgstr "Un client avec cette pièce d'identité est déjà enregistré."

#, python-format
msgid "A maintenance period lasts at most %(max)s nights."
msgstr "Une période de maintenance dure au plus %(max)s nuits."

msgid "A new price only applies to future charges."
msgstr "Un nouveau prix ne s'applique qu'aux prochaines facturations."

#, python-format
msgid "A no-show can only be recorded after the check-in time on %(arrival)s."
msgstr "Une non-présentation ne peut être enregistrée qu'après l'heure d'arrivée du %(arrival)s."

msgid "A passport number has 5 to 20 letters or digits."
msgstr "Un numéro de passeport comporte de 5 à 20 lettres ou chiffres."

msgid "A percentage (7 or 7.5) or an amount in dinars (3.000), depending on the kind."
msgstr "Un pourcentage (7 ou 7,5) ou un montant en dinars (3,000), selon le type."

#, python-format
msgid "A rate period lasts at most %(max)s nights."
msgstr "Une période tarifaire dure au plus %(max)s nuits."

msgid ""
"A rate period replaces the nightly rate of every room in its category. Without one, the weekend "
"rule applies, then the room's own rate. Existing bookings always keep their prices."
msgstr ""
"Une période tarifaire remplace le prix par nuit de toutes les chambres de sa catégorie. Sans "
"période, la règle du week-end s'applique, puis le prix de la chambre. Les réservations existantes"
" gardent toujours leurs prix."

#, python-format
msgid "A report covers at most %(max)s nights (two years)."
msgstr "Un rapport couvre au plus %(max)s nuits (deux ans)."

msgid "A service with this name already exists."
msgstr "Un service portant ce nom existe déjà."

#, python-format
msgid "A stay lasts at most %(max)s nights."
msgstr "Un séjour dure au plus %(max)s nuits."

