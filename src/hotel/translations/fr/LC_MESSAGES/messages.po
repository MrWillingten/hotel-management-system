msgstr "Saisissez le code affiché par l’application pour terminer :"

#, python-format
msgid "Under maintenance: %(rooms)s"
msgstr "En maintenance : %(rooms)s"

msgid "Unit price"
msgstr "Prix unitaire"

msgid "Unit price (DT, before tax)"
msgstr "Prix unitaire (DT, hors taxes)"

