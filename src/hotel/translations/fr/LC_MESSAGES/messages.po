msgid "Card"
msgstr "Carte"

msgid "Card slip or transfer number, if any."
msgstr "Ticket de carte ou numéro de virement, le cas échéant."

msgid "Cash"
msgstr "Espèces"

msgid "Cash received"
msgstr "Encaissé"

msgid "Categories"
msgstr "Catégories"

msgid "Categories group rooms such as Standard, Deluxe or Suite."
msgstr "Les catégories regroupent les chambres, par exemple Standard, Deluxe ou Suite."

msgid "Category"
msgstr "Catégorie"

msgid "Category saved."
msgstr "Catégorie enregistrée."

msgid "Change"
msgstr "Modifier"

msgid "Change dates or rooms; Move guests to another room from tonight on."
msgstr "Modifiez dates ou chambres ; changez les clients de chambre à partir de ce soir."

msgid "Change guest"
msgstr "Changer de client"

msgid "Change of mind after booking (hours)"
msgstr "Délai de rétractation après réservation (heures)"

msgid "Change password"
msgstr "Changer le mot de passe"

msgid "Change reservation"
msgstr "Modifier la réservation"

msgid "Changes saved."
msgstr "Modifications enregistrées."

msgid "Charge"
msgstr "Facturer"

msgid "Charge the new room's price for the remaining nights (an upgrade the guest asked for)"
msgstr ""
"Facturer le prix de la nouvelle chambre pour les nuits restantes (surclassement demandé par le "
"client)"

msgid "Charge voided."
msgstr "Prestation annulée."

#, python-format
msgid "Charged: %(quantity)s × %(name)s."
msgstr "Facturé : %(quantity)s × %(name)s."

#, python-format
msgid "Charges to stays: %(count)s"
msgstr "Facturations sur des séjours : %(count)s"

msgid "Check a guest in"
msgstr "Enregistrer l’arrivée d’un client"

msgid "Check a guest out"
msgstr "Enregistrer le départ d’un client"

msgid "Check availability and price"
msgstr "Vérifier la disponibilité et le prix"

msgid "Check in"
msgstr "Enregistrer l'arrivée"

msgid "Check in and Check out are right next to each guest."
msgstr "« Enregistrer l'arrivée » et « Enregistrer le départ » sont à côté de chaque client."

msgid "Check out"
msgstr "Enregistrer le départ"

msgid "Check out and issue the invoice"
msgstr "Enregistrer le départ et émettre la facture"

msgid ""
"Check-in and check-out times, cancellation fee and window, discount cap, weekend surcharge, "
"anonymisation delay."
msgstr ""
"Heures d’arrivée et de départ, frais et délai d’annulation, plafond de remise, supplément week-"
"end, délai d’anonymisation."

#, python-format
msgid "Check-in from %(in)s · check-out by %(out)s"
msgstr "Arrivée à partir de %(in)s · départ avant %(out)s"

#, python-format
msgid "Check-in opens on the arrival day (%(arrival)s)."
msgstr "L'enregistrement de l'arrivée ouvre le jour d'arrivée (%(arrival)s)."

msgid "Check-in time"
msgstr "Heure d'arrivée"

msgid "Check-out time"
msgstr "Heure de départ"

msgid "Checked in"
msgstr "En séjour"

msgid "Checked out"
msgstr "Départ effectué"

msgid "Children"
msgstr "Enfants"

msgid "Choose"
msgstr "Choisir"

msgid "Choose / Register a new guest"
msgstr "Choisir / enregistrer un nouveau client"

msgid "Choose a category."
msgstr "Choisissez une catégorie."

#, python-format
msgid "Choose a date between %(arrival)s and %(last)s."
msgstr "Choisissez une date entre le %(arrival)s et le %(last)s."

msgid "Choose a document type."
msgstr "Choisissez un type de pièce."

msgid "Choose a guest first."
msgstr "Choisissez d'abord un client."

msgid "Choose a password different from the current one."
msgstr "Choisissez un mot de passe différent de l'actuel."

msgid "Choose a role."
msgstr "Choisissez un rôle."

msgid "Choose a service from the catalogue."
msgstr "Choisissez un service du catalogue."

msgid "Choose how the money was paid."
msgstr "Choisissez le moyen de paiement."

msgid "Choose one of the proposed durations."
msgstr "Choisissez l’une des durées proposées."

msgid "Choose the dates first."
msgstr "Choisissez d'abord les dates."

msgid "Choose the kind of tax and what it applies to."
msgstr "Choisissez le type de taxe et ce à quoi elle s'applique."

msgid "Cleaned, to inspect"
msgstr "Nettoyée, à contrôler"

msgid "Close a day"
msgstr "Clôturer une journée"

msgid "Close for maintenance"
msgstr "Fermer pour maintenance"

msgid "Close the day"
msgstr "Clôturer la journée"

msgid "Close the room"
msgstr "Fermer la chambre"

msgid "Closed by"
msgstr "Clôturée par"

msgid "Closed days"
