msgstr "السابقة"

msgid "Project roadmap"
msgstr "خارطة طريق المشروع"

msgid "Reception and management"
msgstr "الاستقبال والإدارة"

msgid "Receptionist"
msgstr "موظف استقبال"

msgid "Record"
msgstr "السجل"

msgid "Reports, operations and translations"
msgstr "التقارير والعمليات والترجمات"

msgid "Reservations and availability"
msgstr "الحجوزات والتوفر"

msgid "Rooms, guests, staff and audit log"
msgstr "الغرف والنزلاء والموظفون وسجل التدقيق"

msgid "Sign in"
msgstr "تسجيل الدخول"

msgid "Sign out"
msgstr "تسجيل الخروج"

msgid "Skip to content"
msgstr "انتقل إلى المحتوى"

msgid "Some fields need your attention."
msgstr "بعض الحقول تحتاج إلى مراجعة."

msgid "Someone else changed this record. Reload the page to see their changes."
msgstr "قام شخص آخر بتعديل هذا السجل. أعد تحميل الصفحة لرؤية التعديلات."

msgid "Something went wrong"
msgstr "حدث خطأ ما"

msgid "Something went wrong. Try again."
msgstr "حدث خطأ ما. حاول مرة أخرى."

msgid "System"
msgstr "النظام"

msgid "The data sent was too large."
msgstr "البيانات المرسلة كبيرة جدًا."

msgid "The departure date must be after the arrival date."
msgstr "يجب أن يكون تاريخ المغادرة بعد تاريخ الوصول."

msgid "The first manager account already exists."
msgstr "حساب المدير الأول موجود بالفعل."

msgid "The front desk figures will appear here once reservations are available."
msgstr "ستظهر أرقام الاستقبال هنا بمجرد توفر الحجوزات."

msgid "The page you asked for doesn't exist."
msgstr "الصفحة المطلوبة غير موجودة."

msgid "The password must not contain the username."
msgstr "يجب ألا تحتوي كلمة المرور على اسم المستخدم."

msgid "The request couldn't be understood."
msgstr "تعذّر فهم الطلب."

msgid "This action can't be done this way."
msgstr "لا يمكن تنفيذ هذا الإجراء بهذه الطريقة."

msgid "This change conflicts with existing data."
msgstr "يتعارض هذا التغيير مع بيانات موجودة."

msgid "This form expired or was sent from another site. Reload the page and try again."
msgstr "انتهت صلاحية هذا النموذج أو أُرسل من موقع آخر. أعد تحميل الصفحة وحاول مرة أخرى."

msgid "This operation isn't allowed."
msgstr "هذه العملية غير مسموح بها."

msgid "This operation isn't possible in the record's current state."
msgstr "هذه العملية غير ممكنة في الحالة الحالية للسجل."

msgid "This password is too common. Choose a less predictable one."
msgstr "كلمة المرور هذه شائعة جدًا. اختر كلمة يصعب تخمينها."

msgid "This password repeats the same characters too much."
msgstr "كلمة المرور هذه تكرر الأحرف نفسها كثيرًا."

#, python-format
msgid "Time zone: %(tz)s"
msgstr "المنطقة الزمنية: %(tz)s"

msgid "To"
msgstr "إلى"

msgid "Too large"
msgstr "كبير جدًا"

msgid "Too many failed sign-in attempts from this computer. Wait a few minutes and try again."
msgstr "محاولات تسجيل دخول فاشلة كثيرة من هذا الجهاز. انتظر بضع دقائق ثم حاول مرة أخرى."

msgid "Use 3 to 32 characters: letters, digits, dots, hyphens or underscores."
msgstr "استخدم من 3 إلى 32 حرفًا: أحرف لاتينية أو أرقام أو نقاط أو شرطات أو شرطات سفلية."

#, python-format
msgid "Use at least %(min_length)s characters."
msgstr "استخدم %(min_length)s حرفًا على الأقل."

#, python-format
msgid "Use at most %(max_length)s characters."
msgstr "استخدم %(max_length)s حرفًا كحد أقصى."

msgid "Use the account your manager created for you."
msgstr "استخدم الحساب الذي أنشأه لك مديرك."

msgid "User"
msgstr "المستخدم"

msgid "Username"
msgstr "اسم المستخدم"

msgid "Version"
msgstr "الإصدار"

msgid "We couldn't find what you were looking for."
msgstr "لم نعثر على ما تبحث عنه."

#, python-format
msgid "Welcome, %(name)s."
msgstr "مرحبًا، %(name)s."

msgid "When"
msgstr "التاريخ"

msgid "You don't have permission to do that."
msgstr "ليست لديك صلاحية للقيام بذلك."

msgid "You don't have permission to open this page."
msgstr "ليست لديك صلاحية لفتح هذه الصفحة."

msgid "You have been signed out."
msgstr "تم تسجيل خروجك."

#, python-format
msgid "You'll be signed out after %(minutes)s minutes without activity."
msgstr "سيتم تسجيل خروجك بعد %(minutes)s دقيقة من عدم النشاط."

msgid "Your session"
msgstr "جلستك"

